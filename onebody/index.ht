<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>한몸 원정대</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Do+Hyeon&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
:root{
  --bg:#ECE6DA; --ink:#262A33; --soft:#6A6E78; --panel:#FFFDF8; --line:#D3CABA;
  --accent:#E0A21B; --accent-ink:#262A33; --hp:#E5484D; --ammo:#E0A21B; --shield:#3D9BE9; --warn:#C8323A;
  color-scheme:light; box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){ --bg:#17191F; --ink:#ECE6DA; --soft:#9EA2AC; --panel:#22252D; --line:#353944; --accent:#F0B53A; --accent-ink:#17191F; --warn:#FF6A70; color-scheme:dark; }
}
:root[data-theme="dark"]{ --bg:#17191F; --ink:#ECE6DA; --soft:#9EA2AC; --panel:#22252D; --line:#353944; --accent:#F0B53A; --accent-ink:#17191F; --warn:#FF6A70; color-scheme:dark; }
*,*::before,*::after{box-sizing:border-box}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;height:100%;background:var(--bg);color:var(--ink);font-family:'Do Hyeon','Apple SD Gothic Neo','Malgun Gothic','Noto Sans KR',system-ui,sans-serif;overflow:hidden;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
button:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
#app{height:100%;display:flex;flex-direction:column;max-width:860px;margin:0 auto;padding:8px 12px 10px;gap:8px}
header{display:flex;align-items:center;gap:10px;min-height:36px}
.logo{font-size:1.4rem}
.spacer{flex:1}
.ghost{background:transparent;border:2px solid var(--line);border-radius:10px;padding:4px 12px}
#bars{display:grid;grid-template-columns:1.6fr 1fr 1fr auto;gap:10px;align-items:center;background:var(--panel);border:2px solid var(--line);border-radius:12px;padding:6px 10px}
.bar{display:flex;align-items:center;gap:6px;min-width:0}
.bar b{font-weight:400;font-size:.95rem;white-space:nowrap}
.hpbox{flex:1;height:14px;border-radius:7px;background:rgba(0,0,0,.12);overflow:hidden}
#hpfill{height:100%;background:var(--hp);width:100%;transition:width .15s}
.pips{display:flex;gap:3px;flex-wrap:wrap}
.pip{width:7px;height:14px;border-radius:3px;background:rgba(0,0,0,.15)}
.pip.on.a{background:var(--ammo)} .pip.on.s{background:var(--shield);width:12px;border-radius:50% 50% 45% 45%}
#info{font-size:.95rem;white-space:nowrap}
#toprow{display:flex;gap:8px;align-items:center;justify-content:space-between;flex-wrap:wrap}
#roles{display:flex;gap:6px;flex-wrap:wrap}
#callbar{display:flex;gap:6px;margin-left:auto}
.cbtn{border:2px solid var(--line);background:var(--panel);border-radius:999px;padding:4px 12px;font-size:.95rem}
.cbtn.main{background:var(--accent);color:var(--accent-ink);border-color:transparent}
#calls{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);display:none;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;background:var(--panel);border:2px solid var(--line);border-radius:16px;padding:8px;width:min(420px,96%);z-index:5;box-shadow:0 8px 24px rgba(0,0,0,.3)}
#calls.on{display:grid}
#calls button{border:2px solid var(--line);background:var(--bg);border-radius:12px;padding:8px 2px;font-size:1.05rem;line-height:1.1}
#calls button small{display:block;font-size:.68rem;color:var(--soft);margin-top:2px}
#feed{flex:none;height:50px;display:flex;align-items:center;gap:10px;background:var(--panel);border:2px solid var(--line);border-radius:12px;padding:0 12px;overflow:hidden}
#feed .hint{color:var(--soft);font-size:.9rem}
#cdBig{display:none;align-items:baseline;gap:8px;flex:none}
#cdBig .n{font-size:2.1rem;line-height:1;color:var(--accent);animation:pop .2s ease-out}
#cdBig .w{font-size:.82rem;color:var(--soft)}
#shout{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:1px}
.sh{font-size:1rem;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;animation:pop .18s ease-out}
.sh:not(:first-child){font-size:.85rem;color:var(--soft)}
.sh b{font-weight:400;color:var(--accent);margin-right:6px}
@keyframes pop{from{transform:scale(.6);opacity:.2}to{transform:scale(1);opacity:1}}
@media (prefers-reduced-motion: reduce){ .sh,#cdBig .n{animation:none} }
.role{background:var(--panel);border:2px solid var(--line);border-radius:999px;padding:2px 10px;font-size:.85rem}
.role.me{border-color:var(--accent)}
#stage{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;position:relative}
#cv{display:block;border-radius:10px;box-shadow:0 0 0 3px #3A3E4B,0 8px 0 3px #272A33}
#overlay{position:absolute;inset:0;display:none;align-items:center;justify-content:center}
#overlay .card{background:var(--panel);border:3px solid var(--line);border-radius:18px;padding:18px 22px;max-width:360px;width:92%;max-height:96%;overflow:auto;text-align:center}
#overlay h2{margin:0 0 4px;font-size:2rem;font-weight:400}
#overlay p{margin:0 0 10px;color:var(--soft)}
#awards{text-align:left;margin:6px 0 14px;display:flex;flex-direction:column;gap:6px}
.aw{border:2px dashed var(--line);border-radius:10px;padding:6px 10px;font-size:1rem}
.aw small{display:block;color:var(--soft);font-size:.82rem}
#pad{display:none;flex:none;gap:10px;justify-content:space-between;align-items:center;min-height:132px;touch-action:none}
body.touch #pad{display:flex}
.dgrid{display:grid;grid-template-columns:repeat(3,58px);grid-template-rows:repeat(3,58px);gap:4px}
.pbtn{border:none;border-radius:16px;background:var(--panel);border:3px solid var(--line);font-size:1.3rem;touch-action:none}
.pbtn.held{background:var(--accent);color:var(--accent-ink)}
.pbtn.big{width:100%;height:120px;font-size:2rem}
.acts{display:flex;gap:10px}
.act{width:96px;height:96px;border-radius:50%;border:none;font-size:1.15rem;color:#fff;touch-action:none}
.act.fire{background:#D9822B;box-shadow:0 5px 0 #9A5717}
.act.shd{background:#3D9BE9;box-shadow:0 5px 0 #23679F}
.act:active{transform:translateY(3px)}
.screen{position:fixed;inset:0;display:none;overflow:auto;background:var(--bg);padding:calc(env(safe-area-inset-top,0px) + 18px) 16px calc(env(safe-area-inset-bottom,0px) + 18px)}
.screen.on{display:block}
.wrap{max-width:440px;margin:0 auto;display:flex;flex-direction:column;gap:14px}
.hero{text-align:center;padding:6px 0 0}
.hero h1{margin:6px 0 2px;font-size:2.8rem;font-weight:400;letter-spacing:-.01em}
.hero p{margin:0;color:var(--soft);line-height:1.5}
.box{background:var(--panel);border:2px solid var(--line);border-radius:16px;padding:14px}
.box h3{margin:0 0 10px;font-weight:400;font-size:1.15rem}
.row{display:flex;gap:8px;align-items:center}
.field{flex:1;min-width:0;border:2px solid var(--line);background:var(--bg);border-radius:12px;padding:9px 12px;font-size:1rem}
.btn{border:none;border-radius:12px;padding:11px 16px;background:var(--accent);color:var(--accent-ink);font-size:1.1rem;box-shadow:0 4px 0 rgba(0,0,0,.2)}
.btn:active{transform:translateY(2px);box-shadow:0 2px 0 rgba(0,0,0,.2)}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.btn.wide{width:100%}
.btn.alt{background:var(--panel);color:var(--ink);border:2px solid var(--line);box-shadow:0 4px 0 var(--line)}
.note{color:var(--soft);font-size:.9rem;margin:8px 0 0;line-height:1.55}
.err{color:var(--warn);font-size:.92rem;margin:8px 0 0;min-height:1em}
.slot{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:2px dashed var(--line)}
.slot:last-child{border-bottom:none}
.slot .lbl{flex:1}
.slot small{color:var(--soft)}
.code{font-size:2.4rem;text-align:center;letter-spacing:.18em;margin:2px 0 4px}
kbd{font-family:inherit;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:0 5px}
@media (max-width:540px){
  #bars{grid-template-columns:1fr 1fr;row-gap:6px}
  #feed{height:42px}
  .logo{font-size:1.15rem}
}
</style>
</head>
<body>
<div id="app">
  <header>
    <span class="logo">한몸 원정대</span>
    <span class="spacer"></span>
    <button class="ghost" id="muteBtn" aria-label="소리 켜기/끄기">🔊</button>
    <button class="ghost" id="quitBtn">나가기</button>
  </header>
  <div id="bars">
    <div class="bar"><b>체력</b><div class="hpbox"><div id="hpfill"></div></div><b id="hpnum">20</b></div>
    <div class="bar"><b>총알</b><div class="pips" id="ammoPips"></div></div>
    <div class="bar"><b>방어</b><div class="pips" id="shPips"></div></div>
    <div id="info">1/3 · 5:00</div>
  </div>
  <div id="toprow">
    <div id="roles"></div>
    <div id="callbar">
      <button class="cbtn main" id="cdBtn">3·2·1!</button>
      <button class="cbtn" id="callToggle" aria-expanded="false">💬 외치기</button>
    </div>
  </div>
  <div id="feed">
    <div id="cdBig"></div>
    <div id="shout"></div>
    <span class="hint" id="feedHint">3·2·1과 외치기가 여기에 떠요</span>
  </div>
  <div id="stage">
    <canvas id="cv"></canvas>
    <div id="calls"></div>
    <div id="overlay"><div class="card">
      <h2 id="ovTitle">탈출 성공!</h2>
      <p id="ovSub"></p>
      <div id="awards"></div>
      <div class="row" style="justify-content:center" id="ovBtns">
        <button class="btn" id="againBtn">한 판 더</button>
        <button class="btn alt" id="menuBtn">메뉴로</button>
      </div>
    </div></div>
  </div>
  <div id="pad"></div>
</div>

<section class="screen on" id="scrMenu">
  <div class="wrap">
    <div class="hero">
      <svg viewBox="0 0 120 90" width="120" aria-hidden="true">
        <circle cx="60" cy="48" r="30" fill="#E0A21B"/>
        <rect x="40" y="38" width="40" height="14" rx="7" fill="#262A33"/>
        <circle cx="52" cy="45" r="3.5" fill="#7FE0FF"/><circle cx="68" cy="45" r="3.5" fill="#7FE0FF"/>
        <path d="M24 30 L36 40 M96 30 L84 40 M30 72 L40 64 M90 72 L80 64" stroke="#262A33" stroke-width="5" stroke-linecap="round"/>
      </svg>
      <h1>한몸 원정대</h1>
      <p>캐릭터는 하나, 조종은 여럿. 위로 가는 사람, 쏘는 사람이 따로따로예요. 대각선 다리는 3·2·1에 맞춰 같이 눌러야 건너요.<br>구역마다 열쇠 4개를 모아 출구를 열고, 5분 안에 기다란 세 구역을 탈출하세요.</p>
    </div>
    <div class="box">
      <h3>내 이름</h3>
      <input class="field" id="nick" maxlength="8" placeholder="이름 (8자까지)">
    </div>
    <button class="btn wide" id="goSolo">혼자 테스트하기</button>
    <div class="box">
      <h3>친구와 하기 (2~4명)</h3>
      <button class="btn wide" id="goHost">방 만들기</button>
      <div class="row" style="margin-top:10px">
        <input class="field" id="joinCode" maxlength="4" placeholder="방 코드 4자리" autocapitalize="off" autocomplete="off" spellcheck="false">
        <button class="btn" id="goJoin">참여</button>
      </div>
      <p class="err" id="onlineErr"></p>
      <p class="note" id="onlineNote">온라인 연결을 준비하는 중이에요…</p>
    </div>
    <div class="box">
      <h3>역할 나누기</h3>
      <p class="note" style="margin-top:0">2명: 좌우 / 위아래<br>3명: 왼쪽 / 위아래 / 오른쪽<br>4명: 왼쪽 / 위 / 아래 / 오른쪽<br>쏘기와 방어는 인원과 상관없이 모두 누를 수 있어요.<br>한 명이라도 나가면 방이 바로 터져요.</p>
      <p class="note">키보드: <kbd>WASD</kbd>·방향키 이동, <kbd>Space</kbd>·<kbd>J</kbd> 쏘기, <kbd>K</kbd>·<kbd>Shift</kbd> 방어, 숫자키 <kbd>1</kbd>~<kbd>0</kbd>로 외치기(<kbd>1</kbd>은 3·2·1 카운트다운). 방어는 1.5초 유지되고, 공격 맞기 직전 0.3초 안에 켜면 패링이라 방어 횟수가 줄지 않고 적에게 반격해요. 총알은 바라보는 방향으로 나가요.</p>
    </div>
  </div>
</section>

<section class="screen" id="scrLobby">
  <div class="wrap">
    <div class="box" style="text-align:center">
      <h3 style="margin-bottom:0">방 코드</h3>
      <div class="code" id="lobbyCode">----</div>
      <button class="btn wide" id="inviteBtn">초대 링크 보내기</button>
      <p class="note">링크를 받은 친구는 누르기만 하면 코드가 자동으로 들어가요.</p>
    </div>
    <div class="box">
      <h3>참가자와 역할</h3>
      <div id="lobbyList"></div>
    </div>
    <p class="err" id="lobbyErr"></p>
    <div class="row">
      <button class="btn alt" id="lobbyBack">나가기</button>
      <button class="btn" id="lobbyStart" style="flex:1">출발!</button>
    </div>
  </div>
</section>

<script>
(() => {
'use strict';
const $ = id => document.getElementById(id);
let COLS = 15, ROWS = 11, VW = 15, VH = 11;
function setDims(map){ ROWS = map.length; COLS = map[0].length; if (COLS >= ROWS) { VW = Math.min(15, COLS); VH = Math.min(11, ROWS); } else { VW = Math.min(11, COLS); VH = Math.min(15, ROWS); } }
const MAX_HP = 20, START_AMMO = 10, MAX_SH = 5, SHIELD_TIME = 1.5, PARRY_WIN = 0.3, TIME_LIMIT = 300;
const STAGES = [
  { name:'가시 정원', spawn:16, max:1, elite:.1, keys:[[12, 5], [4, 4], [21, 1], [23, 9], [30, 5], [7, 1], [15, 8]], map:[
"############v#######################",
"#.........OOOOOOOO......MOOOOOOOO.E#",
"#.....^.O..OOOOOOO...^...OOOOOOO..O#",
">...^...OO..OOOOOO..#.#..OOOOOO..OO#",
"#...^...OOO..OOOOO.......OOOOO..OOO#",
"#P......OOOO..OOOO.^.M.^.OOOO..OOOO<",
"#...^...OOOOO..OOO.......OOO..OOOOO#",
"#...^...OOOOOO..OO..#.#..OO..OOOOOO#",
"#.^.....OOOOOOO..O...^...O..OOOOOOO#",
"#.....M.OOOOOOOO...M.......OOOOOOOO#",
"####################################"] },
  { name:'구멍 다리', spawn:14, max:1, elite:.2, keys:[[7, 20], [6, 22], [10, 16], [6, 28], [1, 11], [11, 9], [6, 4], [2, 26]], map:[
"########v####",
"#M..E.......#",
"#OOO..OOOOOO#",
"#OOOO..OOOOO#",
"#OOOOO..OOOO#",
"#OOOOOO..OOO#",
"#OOOOOOO..OO#",
"#OOOOOOOO..O#",
"#..........M#",
"#...........<",
"#..#.....#..#",
">...........#",
"#....^^^....#",
"#..#.....#..#",
"#M..........#",
"#...........#",
"#OOOOOOOOO..#",
"#OOOOOOOO..O#",
"#OOOOOOO..OO#",
"#OOOOOO..OOO#",
"#OOOOO..OOOO#",
"#OOOO..OOOOO#",
"#OOOOO..OOOO#",
"#OOOOOO..OOO#",
"#OOOOOOO..OO#",
"#OOOOOOOO..O#",
"#...........#",
"#...........#",
"#.^^^^.^^^^.#",
"#...........#",
"#M.........M#",
"#..#.....#..#",
"#.....P.....#",
"#############"] },
  { name:'톱날 공장', spawn:13, max:2, elite:.25, keys:[[13, 5], [5, 9], [23, 1], [24, 9], [33, 5], [19, 6], [8, 1]], map:[
"########################################",
"#P.........OOOOOOOO.M.......OOOOOOOO..E#",
"#.....^..O..OOOOOOO....V....OOOOOOO..OO#",
"#.....^..OO..OOOOOO..#...#..OOOOOO..OOO#",
"#........OOO..OOOOO^........OOOOO..OOOO#",
"#...H....OOOO..OOOO^...M....OOOO..OOOOO<",
"#........OOOOO..OOO.........OOO..OOOOOO#",
"#..^.....OOOOOO..OO..#...#..OO..OOOOOOO#",
"#..^.....OOOOOOO..O.......^.O..OOOOOOOO#",
"#M.......OOOOOOOO.....H...^...OOOOOOOOO#",
"#############A##########################"] },
];
const ROLESETS = { 1:['udlrfs'], 2:['lrfs','udfs'], 3:['lfs','udfs','rfs'], 4:['lfs','ufs','dfs','rfs'] };
const DIRS = { u:[0,-1], d:[0,1], l:[-1,0], r:[1,0] };
function roleLabel(r){
  if (r === 'udlrfs') return '전부 혼자';
  const parts = [];
  const mv = r.replace(/[fs]/g, '');
  if (mv === 'udlr') parts.push('이동 전부');
  else if (mv === 'ud') parts.push('⬆⬇ 위아래');
  else if (mv === 'lr') parts.push('⬅➡ 좌우');
  else if (mv) parts.push({ u:'⬆ 위', d:'⬇ 아래', l:'⬅ 왼쪽', r:'➡ 오른쪽' }[mv]);
  if (r.includes('f')) parts.push('쏘기·방어');
  return parts.join(' + ');
}

// ───────── 입력 ─────────
const KEYS = { u:['ArrowUp','KeyW'], d:['ArrowDown','KeyS'], l:['ArrowLeft','KeyA'], r:['ArrowRight','KeyD'], f:['Space','KeyJ','KeyZ'], s:['KeyK','KeyX','ShiftLeft','ShiftRight','KeyL'] };
const CODE2 = {}; for (const k in KEYS) KEYS[k].forEach(c => CODE2[c] = k);
const held = new Set();
const touchHeld = { u:false, d:false, l:false, r:false };
const local = { fc:0, sc:0 };
function inGame(){ return mode === 'solo' || mode === 'host' || mode === 'client'; }
addEventListener('keydown', e => {
  initAudio();
  if (e.target && e.target.tagName === 'INPUT') return;
  if (inGame() && CALLKEY[e.code]) { e.preventDefault(); if (!e.repeat) say(CALLKEY[e.code]); return; }
  const k = CODE2[e.code]; if (!k) return;
  if (inGame()) e.preventDefault();
  if (k === 'f') { if (!e.repeat) local.fc++; return; }
  if (k === 's') { if (!e.repeat) local.sc++; return; }
  held.add(e.code);
});
addEventListener('keyup', e => held.delete(e.code));
addEventListener('blur', () => { held.clear(); for (const k in touchHeld) touchHeld[k] = false; });
function localKeys(){
  const on = k => touchHeld[k] || KEYS[k].some(c => held.has(c));
  return [on('u')?1:0, on('d')?1:0, on('l')?1:0, on('r')?1:0, local.fc, local.sc];
}
if (matchMedia('(pointer: coarse)').matches) document.body.classList.add('touch');
addEventListener('touchstart', () => { if (!document.body.classList.contains('touch')) { document.body.classList.add('touch'); buildPad(); requestAnimationFrame(resize); } }, { passive:true });

function buildPad(){
  const pad = $('pad'); pad.textContent = '';
  const role = myRole();
  const mv = role.replace(/[fs]/g, '');
  const mk = (k, label, cls) => {
    const b = document.createElement('button'); b.className = 'pbtn ' + (cls || ''); b.textContent = label;
    const down = e => { e.preventDefault(); initAudio(); touchHeld[k] = true; b.classList.add('held'); try { b.setPointerCapture(e.pointerId); } catch (x) {} };
    const up = () => { touchHeld[k] = false; b.classList.remove('held'); };
    b.addEventListener('pointerdown', down); b.addEventListener('pointerup', up); b.addEventListener('pointercancel', up); b.addEventListener('lostpointercapture', up);
    return b;
  };
  const left = document.createElement('div'); left.style.flex = '1'; left.style.display = 'flex'; left.style.justifyContent = 'flex-start';
  if (mv === 'udlr') {
    const g = document.createElement('div'); g.className = 'dgrid';
    const cells = [null, ['u','▲'], null, ['l','◀'], null, ['r','▶'], null, ['d','▼'], null];
    cells.forEach(c => { if (c) g.appendChild(mk(c[0], c[1])); else g.appendChild(document.createElement('span')); });
    left.appendChild(g);
  } else if (mv === 'ud' || mv === 'lr') {
    const g = document.createElement('div'); g.style.display = 'flex'; g.style.gap = '10px'; g.style.flexDirection = mv === 'ud' ? 'column' : 'row';
    const [a, b] = mv === 'ud' ? [['u','▲'],['d','▼']] : [['l','◀'],['r','▶']];
    const s = mv === 'ud' ? 'width:120px;height:58px' : 'width:88px;height:110px';
    const ba = mk(a[0], a[1]), bb = mk(b[0], b[1]); ba.style.cssText = s; bb.style.cssText = s;
    g.append(ba, bb); left.appendChild(g);
  } else if (mv.length === 1) {
    const b = mk(mv, { u:'▲ 위', d:'▼ 아래', l:'◀ 왼쪽', r:'▶ 오른쪽' }[mv], 'big'); b.style.maxWidth = '220px'; left.appendChild(b);
  }
  pad.appendChild(left);
  if (role.includes('f')) {
    const acts = document.createElement('div'); acts.className = 'acts';
    const f = document.createElement('button'); f.className = 'act fire'; f.textContent = '쏘기';
    const s = document.createElement('button'); s.className = 'act shd'; s.textContent = '방어';
    f.addEventListener('pointerdown', e => { e.preventDefault(); initAudio(); local.fc++; });
    s.addEventListener('pointerdown', e => { e.preventDefault(); initAudio(); local.sc++; });
    acts.append(f, s); pad.appendChild(acts);
  }
}

// ───────── 외치기 ─────────
const CALLS = [
  { id:'cd', label:'3·2·1!', key:'Digit1', hint:'1' },
  { id:'ul', label:'↖', text:'↖ 왼쪽 위로!', key:'Digit2', hint:'2' },
  { id:'u', label:'⬆', text:'⬆ 위로!' },
  { id:'ur', label:'↗', text:'↗ 오른쪽 위로!', key:'Digit3', hint:'3' },
  { id:'stop', label:'멈춰!', text:'✋ 멈춰!!', key:'Digit6', hint:'6' },
  { id:'l', label:'⬅', text:'⬅ 왼쪽으로!' },
  { id:'dl', label:'↙', text:'↙ 왼쪽 아래로!', key:'Digit4', hint:'4' },
  { id:'d', label:'⬇', text:'⬇ 아래로!' },
  { id:'dr', label:'↘', text:'↘ 오른쪽 아래로!', key:'Digit5', hint:'5' },
  { id:'r', label:'➡', text:'➡ 오른쪽으로!' },
  { id:'shoot', label:'쏴!', text:'🔫 쏴!', key:'Digit7', hint:'7' },
  { id:'guard', label:'방어!', text:'🛡 방어!', key:'Digit8', hint:'8' },
  { id:'key', label:'열쇠!', text:'🔑 열쇠 먹자!' },
  { id:'lol', label:'ㅋㅋㅋ', text:'ㅋㅋㅋㅋㅋ', key:'Digit9', hint:'9' },
  { id:'sorry', label:'미안…', text:'미안… 🙏', key:'Digit0', hint:'0' },
];
const CALLMAP = {}; const CALLKEY = {};
CALLS.forEach(c => { CALLMAP[c.id] = c; if (c.key) CALLKEY[c.key] = c.id; });
(function buildCalls(){
  const box = $('calls');
  CALLS.forEach(c => {
    const b = document.createElement('button'); b.textContent = c.label;
    if (c.hint) { const sm = document.createElement('small'); sm.textContent = '키 ' + c.hint; b.appendChild(sm); }
    b.addEventListener('click', () => { say(c.id); toggleCalls(false); });
    box.appendChild(b);
  });
})();
function toggleCalls(on){ const box = $('calls'); const v = on === undefined ? !box.classList.contains('on') : on; box.classList.toggle('on', v); $('callToggle').setAttribute('aria-expanded', String(v)); }
$('callToggle').onclick = () => toggleCalls();
$('cdBtn').onclick = () => say('cd');
let cdTimers = [];
function showSay(name, id){
  const c = CALLMAP[id]; if (!c) return;
  if (id === 'cd') {
    cdTimers.forEach(clearTimeout); cdTimers = [];
    const el = $('cdBig');
    const steps = ['3!', '2!', '1!', '지금!'];
    steps.forEach((txt, i) => cdTimers.push(setTimeout(() => {
      el.textContent = '';
      const n = document.createElement('span'); n.className = 'n'; n.textContent = txt; if (i === 3) n.style.color = '#2FA866';
      const w = document.createElement('span'); w.className = 'w'; w.textContent = name;
      el.append(n, w); el.style.display = 'flex'; feedHint();
      tone(i === 3 ? 1320 : 880, i === 3 ? 1320 : 880, i === 3 ? .25 : .12, 'square', .07);
    }, i * 750)));
    cdTimers.push(setTimeout(() => { el.style.display = 'none'; feedHint(); }, steps.length * 750 + 300));
    return;
  }
  const box = $('shout');
  const d = document.createElement('div'); d.className = 'sh';
  const b = document.createElement('b'); b.textContent = name;
  d.append(b, document.createTextNode(c.text));
  box.prepend(d);
  while (box.children.length > 2) box.lastChild.remove();
  feedHint();
  setTimeout(() => { d.remove(); feedHint(); }, 3000);
  tone(660, 760, .06, 'triangle', .05);
}
function feedHint(){ $('feedHint').style.display = ($('shout').children.length || $('cdBig').style.display === 'flex') ? 'none' : ''; }
const sayLast = new Map();
function say(id){
  if (!CALLMAP[id] || !inGame()) return;
  initAudio();
  if (mode === 'solo') showSay(players[0] ? players[0].name : '나', id);
  else if (mode === 'host') hostSay('host', id);
  else if (mode === 'client' && net && net.conn && net.conn.open) { try { net.conn.send({ t:'say', id }); } catch (e) {} }
}
function hostSay(peer, id){
  if (!CALLMAP[id]) return;
  const now = performance.now();
  if (now - (sayLast.get(peer) || 0) < 400) return;
  sayLast.set(peer, now);
  const pl = players.find(p => p.peer === peer); if (!pl) return;
  sendAll({ t:'say', id, from:pl.name });
  showSay(pl.name, id);
}

// ───────── 소리 ─────────
let AC = null, muted = false;
function initAudio(){ if (AC) { if (AC.state === 'suspended') AC.resume(); return; } try { AC = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {} }
function tone(f1, f2, dur, type, vol){
  if (!AC || muted) return;
  const t = AC.currentTime, o = AC.createOscillator(), g = AC.createGain();
  o.type = type || 'sine'; o.frequency.setValueAtTime(f1, t); o.frequency.exponentialRampToValueAtTime(Math.max(30, f2), t + dur);
  g.gain.setValueAtTime(vol || .1, t); g.gain.exponentialRampToValueAtTime(.0008, t + dur);
  o.connect(g).connect(AC.destination); o.start(t); o.stop(t + dur + .02);
}
const SFX = {
  shot: () => tone(900, 300, .08, 'square', .05),
  hit: () => tone(240, 90, .12, 'sawtooth', .07),
  hurt: () => tone(160, 60, .25, 'sawtooth', .12),
  parry: () => { tone(1400, 1800, .08, 'triangle', .12); setTimeout(() => tone(1800, 2400, .12, 'triangle', .1), 60); },
  block: () => tone(500, 380, .1, 'triangle', .1),
  pick: () => { tone(700, 1000, .07, 'square', .05); setTimeout(() => tone(1000, 1400, .08, 'square', .05), 60); },
  fall: () => tone(600, 80, .5, 'sine', .12),
  empty: () => tone(200, 180, .06, 'square', .05),
  stage: () => { tone(520, 780, .12, 'triangle', .1); setTimeout(() => tone(780, 1040, .16, 'triangle', .1), 120); },
};
$('muteBtn').onclick = () => { muted = !muted; $('muteBtn').textContent = muted ? '🔇' : '🔊'; };

// ───────── 게임 ─────────
let mode = 'menu';       // menu | solo | host | client
let G = null;            // 시뮬레이션 (solo / host)
let VM = null;           // 화면에 그릴 모델 (client)
let players = [];        // [{name, role, peer}]
let myIdx = 0;

function tileAt(map, x, y){ return (x < 0 || y < 0 || x >= COLS || y >= ROWS) ? '#' : map[y][x]; }
const isWall = c => c === '#' || c === '<' || c === '>' || c === 'v' || c === 'A';
function spikeUp(x, y, t){ const ph = ((t + ((x + y) % 2) * 1.5) % 3); return ph >= 1.6; }
function spikeWarn(x, y, t){ const ph = ((t + ((x + y) % 2) * 1.5) % 3); return ph >= 1.15 && ph < 1.6; }

function newGame(plist){
  const g = {
    stage:0, map:null, t:0, time:TIME_LIMIT, ready:2.6, over:false, win:false, overT:0, why:'',
    pl:null, enemies:[], bullets:[], arrows:[], saws:[], items:[], turrets:[], spawners:[], spawnT:2, eid:0,
    fxNew:[], stats:plist.map(() => ({ bump:0, fall:0, trap:0, shots:0, hits:0, miss:0, parry:0, block:0, leak:0, empty:0 })),
    last:plist.map(() => ({ fc:0, sc:0 })), flow:null, flowT:0, bumpDir:'',
  };
  g.pl = { x:1.5, y:1.5, fx:1, fy:0, hp:MAX_HP, ammo:START_AMMO, sh:MAX_SH, shT:0, shAge:0, shBy:0, inv:0, fall:0, safeX:1.5, safeY:1.5, fireCd:0, moving:false };
  loadStage(g, 0);
  return g;
}
function loadStage(g, n){
  const S = STAGES[n];
  g.stage = n; g.map = S.map.map(r => r.split('')); g.t = 0; setDims(g.map);
  g.enemies = []; g.bullets = []; g.arrows = []; g.items = []; g.saws = []; g.turrets = []; g.spawners = [];
  g.spawnT = 8;
  const ks = S.keys.slice().sort(() => Math.random() - .5).slice(0, 4);
  g.keys = ks.map(([x, y]) => ({ x:x + .5, y:y + .5 })); g.keyGot = 0; g.lockMsg = 0;
  for (let y = 0; y < ROWS; y++) for (let x = 0; x < COLS; x++) {
    const c = g.map[y][x];
    if (c === 'P') { g.pl.x = x + .5; g.pl.y = y + .5; g.pl.safeX = g.pl.x; g.pl.safeY = g.pl.y; g.map[y][x] = '.'; }
    else if (c === 'M') { g.spawners.push([x, y]); }
    else if (c === 'H' || c === 'V') { g.saws.push({ x:x + .5, y:y + .5, vx:c === 'H' ? 2.4 : 0, vy:c === 'V' ? 2.4 : 0, a:0, cd:0 }); g.map[y][x] = '.'; }
    else if (c === '>' || c === '<' || c === 'v' || c === 'A') { g.turrets.push({ x, y, dx:c === '>' ? 1 : c === '<' ? -1 : 0, dy:c === 'v' ? 1 : c === 'A' ? -1 : 0, t:1 + Math.random() * 1.5 }); }
  }
  g.pl.fall = 0; g.pl.inv = 1;
}
function fx(g, x, y, text, color){ g.fxNew.push([Math.round(x*10)/10, Math.round(y*10)/10, text, color || '#fff']); }
function solidP(g, tx, ty){ return isWall(tileAt(g.map, tx, ty)); }
function solidE(g, tx, ty){ const c = tileAt(g.map, tx, ty); return isWall(c) || c === 'O'; }
function hitsSolid(g, x, y, r, solid){
  const x0 = Math.floor(x - r), x1 = Math.floor(x + r), y0 = Math.floor(y - r), y1 = Math.floor(y + r);
  for (let ty = y0; ty <= y1; ty++) for (let tx = x0; tx <= x1; tx++) if (solid(g, tx, ty)) return true;
  return false;
}
function moveCircle(g, e, mx, my, r, solid, sp){
  let bx = false, by = false;
  if (mx) { const nx = e.x + mx; if (!hitsSolid(g, nx, e.y, r, solid)) e.x = nx; else bx = true; }
  if (my) { const ny = e.y + my; if (!hitsSolid(g, e.x, ny, r, solid)) e.y = ny; else by = true; }
  // 모서리 보정: 막히면 칸 중앙으로 살짝 밀어 줌
  if (bx && !my) { const cy = Math.floor(e.y) + .5, d = cy - e.y; if (Math.abs(d) > .02) { const ny = e.y + Math.sign(d) * Math.min(Math.abs(d), sp); if (!hitsSolid(g, e.x, ny, r, solid)) e.y = ny; } }
  if (by && !mx) { const cx = Math.floor(e.x) + .5, d = cx - e.x; if (Math.abs(d) > .02) { const nx = e.x + Math.sign(d) * Math.min(Math.abs(d), sp); if (!hitsSolid(g, nx, e.y, r, solid)) e.x = nx; } }
  return { bx, by };
}
function computeFlow(g){
  const D = new Int16Array(COLS*ROWS).fill(-1);
  const sx = Math.floor(g.pl.x), sy = Math.floor(g.pl.y);
  if (solidE(g, sx, sy)) { g.flow = D; return; }
  const q = [[sx, sy]]; D[sy*COLS + sx] = 0;
  for (let i = 0; i < q.length; i++) {
    const [x, y] = q[i];
    for (const [dx, dy] of [[1,0],[-1,0],[0,1],[0,-1]]) {
      const nx = x + dx, ny = y + dy;
      if (solidE(g, nx, ny) || D[ny*COLS + nx] >= 0) continue;
      D[ny*COLS + nx] = D[y*COLS + x] + 1; q.push([nx, ny]);
    }
  }
  g.flow = D;
}
function holders(inp, dirs){ const s = new Set(); for (const d of dirs) for (const p of inp[d]) s.add(p); return [...s]; }
function moverIdx(){ const s = []; players.forEach((p, i) => { if (/[udlr]/.test(p.role)) s.push(i); }); return s; }
function defIdx(){ const s = []; players.forEach((p, i) => { if (p.role.includes('s')) s.push(i); }); return s; }

function hurt(g, dmg, kind, blame){
  const p = g.pl;
  if (p.inv > 0 || p.fall > 0 || g.over) return;
  p.hp -= dmg; p.inv = .9;
  fx(g, p.x, p.y - .5, '-' + dmg, '#FF6B6B');
  for (const i of blame) g.stats[i][kind]++;
  g.sfx = 'hurt';
}
function attack(g, dmg, src, srcKind, inp){
  const p = g.pl;
  if (p.fall > 0 || g.over) return 'none';
  if (p.shT > 0) {
    if (p.shAge <= PARRY_WIN) {
      p.sh = Math.min(MAX_SH, p.sh + 1);
      g.stats[p.shBy].parry++;
      fx(g, p.x, p.y - .6, '패링!', '#FFE066'); g.sfx = 'parry';
      if (srcKind === 'enemy') { src.hp -= 1; src.stun = 1; knock(g, src, 1.1); if (src.hp <= 0) killEnemy(g, src, p.shBy, false); }
      return 'parry';
    }
    g.stats[p.shBy].block++;
    fx(g, p.x, p.y - .6, '막음', '#9BD3FF'); g.sfx = 'block';
    if (srcKind === 'enemy') { src.stun = .35; knock(g, src, .7); }
    return 'block';
  }
  if (p.inv > 0) return 'none';
  const blame = srcKind === 'saw' ? holders(inp, ['u','d','l','r']) : defIdx();
  hurt(g, dmg, srcKind === 'saw' ? 'trap' : 'leak', blame.length ? blame : (srcKind === 'saw' ? moverIdx() : defIdx()));
  return 'hit';
}
function knock(g, e, dist){
  const dx = e.x - g.pl.x, dy = e.y - g.pl.y, l = Math.hypot(dx, dy) || 1;
  for (let i = 0; i < 6; i++) moveCircle(g, e, dx/l*dist/6, dy/l*dist/6, .33, solidE, 0);
}
function killEnemy(g, e, by, shot){
  e.dead = true;
  const chance = e.type === 1 ? .45 : .15;
  if (Math.random() < chance) g.items.push({ x:e.x, y:e.y, t:0 });
  fx(g, e.x, e.y, e.type === 1 ? '엘리트 처치!' : '펑', '#FFD86B');
}
function spawnEnemy(g){
  const S = STAGES[g.stage];
  const cands = g.spawners.filter(([x, y]) => { const d = Math.hypot(x + .5 - g.pl.x, y + .5 - g.pl.y); return d > 3.5 && d < 13; });
  if (!cands.length) return;
  const [x, y] = cands[Math.floor(Math.random() * cands.length)];
  const elite = Math.random() < S.elite;
  g.enemies.push({ id:++g.eid, x:x + .5, y:y + .5, type:elite ? 1 : 0, hp:elite ? 3 : 1, wind:0, cd:.6, stun:.4, spk:0, sawCd:0 });
}

function step(g, inp, dt){
  g.sfx = null;
  if (g.over) { g.overT += dt; return; }
  if (g.ready > 0) { g.ready -= dt; return; }
  g.t += dt; g.time -= dt;
  const p = g.pl;
  if (p.inv > 0) p.inv -= dt;
  if (p.fireCd > 0) p.fireCd -= dt;
  // 방어
  if (inp.shield.length) {
    if (p.shT <= 0 && p.sh > 0) { p.sh--; p.shT = SHIELD_TIME; p.shAge = 0; p.shBy = inp.shield[0]; g.sfx = 'block'; }
  }
  if (p.shT > 0) { p.shT -= dt; p.shAge += dt; }
  // 공격
  if (inp.fire.length && p.fireCd <= 0 && p.fall <= 0) {
    const by = inp.fire[0]; p.fireCd = .2;
    if (p.ammo > 0) {
      p.ammo--; g.stats[by].shots++;
      g.bullets.push({ x:p.x + p.fx*.35, y:p.y + p.fy*.35, vx:p.fx*10, vy:p.fy*10, by, hit:false });
      g.sfx = 'shot';
    } else { g.stats[by].empty++; fx(g, p.x, p.y - .6, '총알 없음', '#ccc'); g.sfx = 'empty'; }
  }
  // 이동
  p.moving = false;
  if (p.fall > 0) {
    p.fall -= dt;
    if (p.fall <= 0) { p.x = p.safeX; p.y = p.safeY; p.inv = 0; hurt(g, 5, 'fall', []); p.inv = 1.2; }
  } else {
    let dx = (inp.r.length ? 1 : 0) - (inp.l.length ? 1 : 0), dy = (inp.d.length ? 1 : 0) - (inp.u.length ? 1 : 0);
    if (dx || dy) {
      const l = Math.hypot(dx, dy); dx /= l; dy /= l; p.fx = dx; p.fy = dy; p.moving = true;
      const sp = 3.2 * dt;
      const b = moveCircle(g, p, dx*sp, dy*sp, .32, solidP, sp);
      const bd = (b.bx ? (dx > 0 ? 'r' : 'l') : '') + (b.by ? (dy > 0 ? 'd' : 'u') : '');
      if (bd && bd !== g.bumpDir) { for (const i of holders(inp, bd.split(''))) g.stats[i].bump++; }
      g.bumpDir = bd;
    } else g.bumpDir = '';
    const tx = Math.floor(p.x), ty = Math.floor(p.y), c = g.map[ty][tx];
    if (c === 'O') {
      p.fall = .6; p.shT = 0; g.sfx = 'fall';
      const bl = holders(inp, ['u','d','l','r']);
      for (const i of (bl.length ? bl : moverIdx())) g.stats[i].fall++;
      fx(g, p.x, p.y - .6, '으아아', '#fff');
    } else {
      if (c === '^' && spikeUp(tx, ty, g.t)) {
        const bl = holders(inp, ['u','d','l','r']);
        if (p.inv <= 0) hurt(g, 3, 'trap', bl.length ? bl : moverIdx());
      } else if (c !== '^') { p.safeX = tx + .5; p.safeY = ty + .5; }
      if (g.lockMsg > 0) g.lockMsg -= dt;
      if (c === 'E' && g.keyGot < g.keys.length) {
        if (g.lockMsg <= 0) { fx(g, p.x, p.y - .7, '열쇠 ' + (g.keys.length - g.keyGot) + '개 더!', '#FFB347'); g.lockMsg = 1.5; }
      } else if (c === 'E') {
        if (g.stage + 1 >= STAGES.length) { g.over = true; g.win = true; g.why = 'win'; g.sfx = 'stage'; return; }
        loadStage(g, g.stage + 1); g.sfx = 'stage'; fx(g, g.pl.x, g.pl.y - .8, STAGES[g.stage].name, '#FFE066'); return;
      }
    }
  }
  // 열쇠
  for (const k of g.keys) if (!k.got && p.fall <= 0 && Math.hypot(k.x - p.x, k.y - p.y) < .55) {
    k.got = true; g.keyGot++; g.sfx = 'pick';
    fx(g, p.x, p.y - .7, g.keyGot >= g.keys.length ? '출구 열림!' : '열쇠 ' + g.keyGot + '/' + g.keys.length, '#FFE066');
  }
  // 아이템
  for (const it of g.items) { it.t += dt; if (!it.got && Math.hypot(it.x - p.x, it.y - p.y) < .6 && p.fall <= 0) { it.got = true; p.ammo += 3; fx(g, p.x, p.y - .6, '총알 +3', '#FFD86B'); g.sfx = 'pick'; } }
  g.items = g.items.filter(it => !it.got && it.t < 20);
  // 총알
  for (const b of g.bullets) {
    b.x += b.vx*dt; b.y += b.vy*dt;
    if (isWall(tileAt(g.map, Math.floor(b.x), Math.floor(b.y)))) { b.dead = true; if (!b.hit) g.stats[b.by].miss++; continue; }
    for (const e of g.enemies) {
      if (!e.dead && Math.hypot(e.x - b.x, e.y - b.y) < .42) {
        b.dead = true; b.hit = true; e.hp--; g.stats[b.by].hits++; e.stun = Math.max(e.stun, .15); g.sfx = 'hit';
        if (e.hp <= 0) killEnemy(g, e, b.by, true);
        break;
      }
    }
  }
  g.bullets = g.bullets.filter(b => !b.dead);
  // 화살 발사대
  for (const tr of g.turrets) {
    tr.t -= dt;
    if (tr.t <= 0) { tr.t = 2.1; g.arrows.push({ x:tr.x + .5 + tr.dx*.6, y:tr.y + .5 + tr.dy*.6, vx:tr.dx*5.5, vy:tr.dy*5.5 }); }
  }
  for (const a of g.arrows) {
    a.x += a.vx*dt; a.y += a.vy*dt;
    if (isWall(tileAt(g.map, Math.floor(a.x), Math.floor(a.y)))) { a.dead = true; continue; }
    if (p.fall <= 0 && Math.hypot(a.x - p.x, a.y - p.y) < .42) { const r = attack(g, 3, a, 'arrow', inp); if (r !== 'none') a.dead = true; }
  }
  g.arrows = g.arrows.filter(a => !a.dead);
  // 톱날
  for (const s of g.saws) {
    s.a += dt*12; if (s.cd > 0) s.cd -= dt;
    const nx = s.x + s.vx*dt, ny = s.y + s.vy*dt;
    const lx = Math.floor(nx + Math.sign(s.vx)*.45), ly = Math.floor(ny + Math.sign(s.vy)*.45);
    if (solidE(g, s.vx ? lx : Math.floor(nx), s.vy ? ly : Math.floor(ny))) { s.vx = -s.vx; s.vy = -s.vy; }
    else { s.x = nx; s.y = ny; }
    if (s.cd <= 0 && p.fall <= 0 && Math.hypot(s.x - p.x, s.y - p.y) < .66) {
      const r = attack(g, 4, s, 'saw', inp);
      if (r !== 'none') s.cd = .7;
      if (r === 'block' || r === 'parry') { const dx = p.x - s.x, dy = p.y - s.y, l = Math.hypot(dx, dy) || 1; for (let i = 0; i < 5; i++) moveCircle(g, p, dx/l*.12, dy/l*.12, .32, solidP, 0); }
    }
    for (const e of g.enemies) if (!e.dead && e.sawCd <= 0 && Math.hypot(s.x - e.x, s.y - e.y) < .65) { e.hp--; e.sawCd = .8; if (e.hp <= 0) killEnemy(g, e, 0, false); }
  }
  // 적
  g.flowT -= dt; if (g.flowT <= 0 || !g.flow) { computeFlow(g); g.flowT = .25; }
  for (const e of g.enemies) {
    if (e.dead) continue;
    if (e.sawCd > 0) e.sawCd -= dt;
    if (e.stun > 0) { e.stun -= dt; continue; }
    const etx = Math.floor(e.x), ety = Math.floor(e.y);
    if (g.map[ety][etx] === '^' && spikeUp(etx, ety, g.t)) { if (e.spk <= 0) { e.hp--; e.spk = 1; if (e.hp <= 0) { killEnemy(g, e, 0, false); continue; } } }
    if (e.spk > 0) e.spk -= dt;
    const dist = Math.hypot(p.x - e.x, p.y - e.y);
    const dmg = e.type === 1 ? 5 : 3;
    if (e.wind > 0) {
      e.wind -= dt;
      if (e.wind <= 0) { e.cd = 1.1; if (dist < 1.15 && p.fall <= 0) attack(g, dmg, e, 'enemy', inp); }
      continue;
    }
    if (e.cd > 0) e.cd -= dt;
    if (dist < .95 && e.cd <= 0 && p.fall <= 0) { e.wind = e.type === 1 ? .7 : .6; continue; }
    if (dist < .7) continue;
    let tx = p.x, ty = p.y;
    const D = g.flow, here = D[ety*COLS + etx];
    if (here > 1) {
      let best = here, bx = etx, by = ety;
      for (const [dx, dy] of [[1,0],[-1,0],[0,1],[0,-1]]) { const v = D[(ety+dy)*COLS + etx + dx]; if (v >= 0 && v < best) { best = v; bx = etx + dx; by = ety + dy; } }
      tx = bx + .5; ty = by + .5;
    }
    const sp = (e.type === 1 ? 1.45 : 1.9) * dt, ddx = tx - e.x, ddy = ty - e.y, l = Math.hypot(ddx, ddy) || 1;
    moveCircle(g, e, ddx/l*sp, ddy/l*sp, .33, solidE, sp);
  }
  g.enemies = g.enemies.filter(e => !e.dead);
  // 생성
  g.spawnT -= dt;
  if (g.spawnT <= 0) { const S = STAGES[g.stage]; if (g.enemies.length < S.max) spawnEnemy(g); g.spawnT = S.spawn * (.75 + Math.random()*.5); }
  // 끝
  if (p.hp <= 0) { p.hp = 0; g.over = true; g.why = 'dead'; }
  else if (g.time <= 0) { g.time = 0; g.over = true; g.why = 'time'; }
}

// ───────── 입력 합치기 ─────────
let remoteKeys = new Map(); // peer -> [u,d,l,r,fc,sc]
function gatherInput(){
  const inp = { u:[], d:[], l:[], r:[], fire:[], shield:[] };
  players.forEach((pl, i) => {
    const k = (pl.local ? localKeys() : remoteKeys.get(pl.peer)) || [0,0,0,0,0,0];
    const role = pl.role;
    ['u','d','l','r'].forEach((d, j) => { if (role.includes(d) && k[j]) inp[d].push(i); });
    const last = G.last[i];
    const fc = num(k[4], 0), sc = num(k[5], 0);
    if (fc > last.fc) { if (role.includes('f')) inp.fire.push(i); }
    if (sc > last.sc) { if (role.includes('s')) inp.shield.push(i); }
    last.fc = fc; last.sc = sc;
  });
  return inp;
}
function num(v, d){ v = Number(v); return Number.isFinite(v) ? v : d; }

// ───────── 직렬화 (방장 → 친구) ─────────
const r1 = v => Math.round(v*100)/100;
function snapshot(g, fxs){
  const p = g.pl;
  return {
    st:g.stage, tt:r1(g.t), tm:Math.ceil(g.time), rd:r1(g.ready),
    p:[r1(p.x), r1(p.y), r1(p.fx), r1(p.fy), p.hp, p.ammo, p.sh, r1(p.shT), r1(p.shAge), r1(p.inv), r1(p.fall), p.moving ? 1 : 0],
    e:g.enemies.slice(0, 20).map(e => [e.id, r1(e.x), r1(e.y), e.type, e.hp, r1(e.wind), r1(e.stun)]),
    b:g.bullets.slice(0, 20).map(b => [r1(b.x), r1(b.y)]),
    a:g.arrows.slice(0, 20).map(a => [r1(a.x), r1(a.y), Math.sign(a.vx), Math.sign(a.vy)]),
    s:g.saws.map(s => [r1(s.x), r1(s.y)]),
    i:g.items.map(it => [r1(it.x), r1(it.y)]),
    k:g.keys.map(k => [r1(k.x), r1(k.y), k.got ? 1 : 0]),
    fx:(fxs || []).slice(0, 10), sfx:g.sfxSent || null,
    o:g.over ? 1 : 0, w:g.win ? 1 : 0, why:g.why, stats:g.over ? g.stats : null,
  };
}
function viewFromSnap(s){
  const p = s.p || [];
  const v = {
    stage:Math.max(0, Math.min(2, num(s.st, 0))), t:num(s.tt, 0), time:num(s.tm, 0), ready:num(s.rd, 0),
    pl:{ x:num(p[0], 1.5), y:num(p[1], 1.5), fx:num(p[2], 1), fy:num(p[3], 0), hp:num(p[4], 0), ammo:num(p[5], 0), sh:num(p[6], 0), shT:num(p[7], 0), shAge:num(p[8], 0), inv:num(p[9], 0), fall:num(p[10], 0), moving:!!p[11] },
    enemies:(Array.isArray(s.e) ? s.e : []).map(a => ({ id:a[0], x:num(a[1], 0), y:num(a[2], 0), type:num(a[3], 0), hp:num(a[4], 1), wind:num(a[5], 0), stun:num(a[6], 0) })),
    bullets:(Array.isArray(s.b) ? s.b : []).map(a => ({ x:num(a[0], -5), y:num(a[1], -5) })),
    arrows:(Array.isArray(s.a) ? s.a : []).map(a => ({ x:num(a[0], -5), y:num(a[1], -5), vx:num(a[2], 1), vy:num(a[3], 0) })),
    saws:(Array.isArray(s.s) ? s.s : []).map(a => ({ x:num(a[0], -5), y:num(a[1], -5), a:0 })),
    items:(Array.isArray(s.i) ? s.i : []).map(a => ({ x:num(a[0], -5), y:num(a[1], -5), t:0 })),
    keys:(Array.isArray(s.k) ? s.k : []).slice(0, 5).map(a => ({ x:num(a[0], -5), y:num(a[1], -5), got:!!a[2] })),
    over:!!s.o, win:!!s.w, why:String(s.why || ''), stats:Array.isArray(s.stats) ? s.stats : null,
  };
  v.keyGot = v.keys.filter(k => k.got).length;
  v.map = STAGES[v.stage].map.map(r => r.split('').map(c => c === 'P' || c === 'H' || c === 'V' ? '.' : c));
  setDims(v.map);
  return v;
}

// ───────── 그리기 ─────────
const cv = $('cv'), ctx = cv.getContext('2d');
let T = 40, dpr = 1, dimKey = '';
function resize(){
  const st = $('stage'); const w = st.clientWidth, h = st.clientHeight;
  T = Math.max(14, Math.floor(Math.min(w / VW, h / VH)));
  dpr = Math.min(3, window.devicePixelRatio || 1);
  cv.width = VW*T*dpr; cv.height = VH*T*dpr; cv.style.width = VW*T + 'px'; cv.style.height = VH*T + 'px';
  dimKey = VW + 'x' + VH;
}
addEventListener('resize', resize);
function rr(x, y, w, h, r){ ctx.beginPath(); if (ctx.roundRect) ctx.roundRect(x, y, w, h, r); else ctx.rect(x, y, w, h); }
const floats = []; // {x,y,text,color,t}
const disp = { pl:null, en:new Map() };
let camX = 0, camY = 0;
function draw(v, now){
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.fillStyle = '#1D1F26'; ctx.fillRect(0, 0, VW*T, VH*T);
  const t = now / 1000;
  const P0 = disp.pl || v.pl;
  const tx = Math.max(0, Math.min(COLS - VW, P0.x - VW/2)), ty = Math.max(0, Math.min(ROWS - VH, P0.y - VH/2));
  if (Math.abs(tx - camX) > 4 || Math.abs(ty - camY) > 4) { camX = tx; camY = ty; } else { camX += (tx - camX)*.18; camY += (ty - camY)*.18; }
  ctx.translate(-Math.round(camX*T), -Math.round(camY*T));
  const X0 = Math.max(0, Math.floor(camX)), X1 = Math.min(COLS - 1, Math.ceil(camX + VW)), Y0 = Math.max(0, Math.floor(camY)), Y1 = Math.min(ROWS - 1, Math.ceil(camY + VH));
  for (let y = Y0; y <= Y1; y++) for (let x = X0; x <= X1; x++) {
    const c = v.map[y][x], px = x*T, py = y*T;
    ctx.fillStyle = (x + y) % 2 ? '#3B3F4C' : '#414654';
    ctx.fillRect(px, py, T, T);
    if (c === 'O') {
      ctx.fillStyle = '#0B0C10'; rr(px + T*.04, py + T*.04, T*.92, T*.92, T*.18); ctx.fill();
      ctx.fillStyle = 'rgba(80,90,120,.35)'; rr(px + T*.04, py + T*.04, T*.92, T*.22, T*.12); ctx.fill();
    } else if (c === '^') {
      const up = spikeUp(x, y, v.t), warn = spikeWarn(x, y, v.t);
      ctx.fillStyle = warn ? (Math.floor(t*10) % 2 ? '#7A3A3A' : '#5A2F33') : '#33363F';
      rr(px + T*.08, py + T*.08, T*.84, T*.84, T*.12); ctx.fill();
      for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) {
        const sx = px + T*(.25 + i*.25), sy = py + T*(.25 + j*.25);
        if (up) { ctx.fillStyle = '#D9DEE7'; ctx.beginPath(); ctx.moveTo(sx - T*.08, sy + T*.08); ctx.lineTo(sx + T*.08, sy + T*.08); ctx.lineTo(sx, sy - T*.1); ctx.fill(); }
        else { ctx.fillStyle = '#1D1F25'; ctx.beginPath(); ctx.arc(sx, sy, T*.04, 0, Math.PI*2); ctx.fill(); }
      }
    } else if (c === 'E') {
      const g = v.keyGot < v.keys.length ? 0 : .5 + .5*Math.sin(t*4);
      ctx.fillStyle = v.keyGot < v.keys.length ? 'rgba(120,120,130,.45)' : `rgba(90,220,140,${.35 + g*.3})`; rr(px + T*.06, py + T*.06, T*.88, T*.88, T*.2); ctx.fill();
      ctx.strokeStyle = '#7CF0A8'; ctx.lineWidth = Math.max(2, T*.07); rr(px + T*.14, py + T*.14, T*.72, T*.72, T*.16); ctx.stroke();
      const locked = v.keyGot < v.keys.length;
      ctx.fillStyle = '#E9FFF1'; ctx.font = `${Math.round(T*.32)}px 'Do Hyeon', sans-serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(locked ? '🔒' : '출구', px + T/2, py + T/2);
    } else if (c === 'M') {
      ctx.strokeStyle = 'rgba(190,120,255,.55)'; ctx.lineWidth = Math.max(1.5, T*.05);
      ctx.beginPath(); ctx.arc(px + T/2, py + T/2, T*.34, 0, Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.arc(px + T/2, py + T/2, T*.2, t, t + Math.PI*1.3); ctx.stroke();
    } else if (isWall(c)) {
      ctx.fillStyle = '#23262F'; ctx.fillRect(px, py, T, T);
      ctx.fillStyle = '#5C6274'; rr(px + T*.04, py + T*.04, T*.92, T*.7, T*.12); ctx.fill();
      ctx.fillStyle = '#737A8E'; rr(px + T*.12, py + T*.1, T*.5, T*.14, T*.07); ctx.fill();
      if (c === '>' || c === '<' || c === 'v' || c === 'A') {
        const dx = c === '>' ? 1 : c === '<' ? -1 : 0, dy = c === 'v' ? 1 : c === 'A' ? -1 : 0;
        ctx.fillStyle = '#9C5B2E'; rr(px + T*.28, py + T*.28, T*.44, T*.44, T*.1); ctx.fill();
        ctx.fillStyle = '#111'; ctx.beginPath(); ctx.arc(px + T/2 + dx*T*.26, py + T/2 + dy*T*.26, T*.1, 0, Math.PI*2); ctx.fill();
      }
    }
  }
  // 열쇠
  for (const k of v.keys) {
    if (k.got) continue;
    const x = k.x*T, y = k.y*T + Math.sin(t*4 + k.x)*T*.06;
    ctx.fillStyle = 'rgba(255,224,102,.25)'; ctx.beginPath(); ctx.arc(x, y, T*.36, 0, Math.PI*2); ctx.fill();
    ctx.strokeStyle = '#FFD23F'; ctx.lineWidth = Math.max(2, T*.08); ctx.lineCap = 'round';
    ctx.beginPath(); ctx.arc(x - T*.1, y, T*.11, 0, Math.PI*2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x + .01*T, y); ctx.lineTo(x + T*.22, y); ctx.moveTo(x + T*.16, y); ctx.lineTo(x + T*.16, y + T*.09); ctx.stroke();
  }
  // 아이템
  for (const it of v.items) {
    const bob = Math.sin(t*5 + it.x) * T*.05, x = it.x*T, y = it.y*T + bob;
    ctx.fillStyle = '#E0A21B'; rr(x - T*.2, y - T*.15, T*.4, T*.3, T*.06); ctx.fill();
    ctx.fillStyle = '#7A5208'; ctx.font = `${Math.round(T*.22)}px 'Do Hyeon', sans-serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('+3', x, y + T*.01);
  }
  // 톱날
  for (const s of v.saws) {
    const x = s.x*T, y = s.y*T, a = t*12;
    ctx.save(); ctx.translate(x, y); ctx.rotate(a);
    ctx.fillStyle = '#C9CFDA';
    ctx.beginPath();
    for (let i = 0; i < 16; i++) { const r = i % 2 ? T*.28 : T*.4, an = i/16*Math.PI*2; ctx.lineTo(Math.cos(an)*r, Math.sin(an)*r); }
    ctx.closePath(); ctx.fill();
    ctx.fillStyle = '#6E7585'; ctx.beginPath(); ctx.arc(0, 0, T*.1, 0, Math.PI*2); ctx.fill();
    ctx.restore();
  }
  // 적
  for (const e of v.enemies) {
    let d = disp.en.get(e.id); const pos = d || e;
    const x = pos.x*T, y = pos.y*T, el = e.type === 1;
    const r = T*(el ? .38 : .32), squish = 1 + Math.sin(t*8 + e.id)*.06;
    if (e.wind > 0) {
      const tot = el ? .7 : .6, k = 1 - e.wind/tot;
      ctx.strokeStyle = `rgba(255,70,70,${.4 + k*.6})`; ctx.lineWidth = Math.max(2, T*.06);
      ctx.beginPath(); ctx.arc(x, y, T*(.95 - k*.35), 0, Math.PI*2); ctx.stroke();
    }
    ctx.fillStyle = 'rgba(0,0,0,.3)'; ctx.beginPath(); ctx.ellipse(x, y + r*.8, r*.9, r*.3, 0, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = e.stun > 0 ? '#BBBBBB' : el ? '#9B5DE5' : '#6BCB4B';
    ctx.beginPath(); ctx.ellipse(x, y, r*squish, r/squish, 0, 0, Math.PI*2); ctx.fill();
    if (el) { ctx.fillStyle = '#F4D35E'; for (const s of [-1, 1]) { ctx.beginPath(); ctx.moveTo(x + s*r*.5, y - r*.6); ctx.lineTo(x + s*r*.8, y - r*1.25); ctx.lineTo(x + s*r*.15, y - r*.8); ctx.fill(); } }
    ctx.fillStyle = '#1B1B1B';
    for (const s of [-1, 1]) { ctx.beginPath(); ctx.arc(x + s*r*.35, y - r*.1, r*.13, 0, Math.PI*2); ctx.fill(); }
    if (el && e.hp > 0) { for (let i = 0; i < e.hp; i++) { ctx.fillStyle = '#FF5C5C'; ctx.fillRect(x - T*.24 + i*T*.17, y - r - T*.2, T*.13, T*.07); } }
  }
  // 화살 / 총알
  for (const a of v.arrows) {
    ctx.save(); ctx.translate(a.x*T, a.y*T); ctx.rotate(Math.atan2(a.vy || 0, a.vx || 1));
    ctx.strokeStyle = '#D9B38C'; ctx.lineWidth = Math.max(2, T*.07); ctx.beginPath(); ctx.moveTo(-T*.3, 0); ctx.lineTo(T*.2, 0); ctx.stroke();
    ctx.fillStyle = '#EDEDED'; ctx.beginPath(); ctx.moveTo(T*.32, 0); ctx.lineTo(T*.16, -T*.09); ctx.lineTo(T*.16, T*.09); ctx.fill();
    ctx.restore();
  }
  for (const b of v.bullets) { ctx.fillStyle = '#FFE066'; ctx.beginPath(); ctx.arc(b.x*T, b.y*T, T*.09, 0, Math.PI*2); ctx.fill(); }
  // 플레이어
  const P = v.pl, pp = disp.pl || P;
  if (!(P.inv > 0 && Math.floor(t*14) % 2 && P.fall <= 0)) {
    const sc = P.fall > 0 ? Math.max(.05, P.fall / .6) : 1;
    const x = pp.x*T, y = pp.y*T - (P.moving ? Math.abs(Math.sin(t*12))*T*.05 : 0), r = T*.33*sc;
    ctx.save(); ctx.translate(x, y); ctx.rotate(P.fall > 0 ? (1 - sc)*6 : 0);
    ctx.fillStyle = 'rgba(0,0,0,.3)'; ctx.beginPath(); ctx.ellipse(0, r*.85, r*.9, r*.3, 0, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#E0A21B'; ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI*2); ctx.fill();
    const ang = Math.atan2(P.fy, P.fx);
    ctx.rotate(ang);
    ctx.fillStyle = '#262A33'; rr(r*.05, -r*.42, r*.9, r*.84, r*.35); ctx.fill();
    ctx.fillStyle = '#7FE0FF'; ctx.beginPath(); ctx.arc(r*.55, -r*.18, r*.11, 0, Math.PI*2); ctx.arc(r*.55, r*.18, r*.11, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#8A8F9C'; rr(r*.7, -r*.12, r*.65, r*.24, r*.08); ctx.fill();
    ctx.restore();
    if (P.shT > 0) {
      const parry = P.shAge <= PARRY_WIN;
      ctx.strokeStyle = parry ? '#FFE066' : 'rgba(110,190,255,.9)'; ctx.lineWidth = Math.max(2, T*(parry ? .1 : .07));
      ctx.fillStyle = parry ? 'rgba(255,224,102,.18)' : 'rgba(110,190,255,.15)';
      ctx.beginPath(); ctx.arc(x, y, T*.52, 0, Math.PI*2); ctx.fill(); ctx.stroke();
      ctx.strokeStyle = 'rgba(255,255,255,.7)'; ctx.lineWidth = Math.max(1.5, T*.04);
      ctx.beginPath(); ctx.arc(x, y, T*.6, -Math.PI/2, -Math.PI/2 + (P.shT / SHIELD_TIME)*Math.PI*2); ctx.stroke();
    }
  }
  // 떠오르는 글자
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  for (let i = floats.length - 1; i >= 0; i--) {
    const f = floats[i]; f.t += 1/60;
    if (f.t > 1) { floats.splice(i, 1); continue; }
    ctx.globalAlpha = 1 - f.t; ctx.fillStyle = f.color;
    ctx.font = `${Math.round(T*.42)}px 'Do Hyeon', sans-serif`;
    ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(0,0,0,.6)';
    ctx.strokeText(f.text, f.x*T, (f.y - f.t*.6)*T); ctx.fillText(f.text, f.x*T, (f.y - f.t*.6)*T);
  }
  ctx.globalAlpha = 1;
  // 시작 카운트다운
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  if (v.ready > 0) {
    ctx.fillStyle = 'rgba(15,16,22,.55)'; ctx.fillRect(0, 0, VW*T, VH*T);
    ctx.fillStyle = '#fff'; ctx.font = `${Math.round(T*1.6)}px 'Do Hyeon', sans-serif`;
    ctx.fillText(v.ready > 2 ? STAGES[v.stage].name : String(Math.ceil(v.ready)), VW*T/2, VH*T/2 - T*.3);
    ctx.font = `${Math.round(T*.5)}px 'Do Hyeon', sans-serif`;
    const me = players[myIdx];
    if (me) ctx.fillText('내 담당: ' + roleLabel(me.role), VW*T/2, VH*T/2 + T*1.1);
  }
}
let hudKey = '';
function updateHud(v){
  const P = v.pl;
  $('hpfill').style.width = Math.max(0, P.hp / MAX_HP * 100) + '%';
  $('hpnum').textContent = Math.max(0, P.hp);
  const key = P.ammo + ',' + P.sh;
  if (key !== hudKey) {
    hudKey = key;
    const a = $('ammoPips'); a.textContent = '';
    const n = Math.max(10, P.ammo);
    for (let i = 0; i < n; i++) { const s = document.createElement('span'); s.className = 'pip a' + (i < P.ammo ? ' on' : ''); a.appendChild(s); }
    const sh = $('shPips'); sh.textContent = '';
    for (let i = 0; i < MAX_SH; i++) { const s = document.createElement('span'); s.className = 'pip s' + (i < P.sh ? ' on' : ''); sh.appendChild(s); }
  }
  const tm = Math.max(0, Math.ceil(v.time));
  $('info').textContent = (v.stage + 1) + '/3 ' + STAGES[v.stage].name + ' · 🔑' + v.keyGot + '/' + v.keys.length + ' · ' + Math.floor(tm/60) + ':' + String(tm % 60).padStart(2, '0');
}
function renderRoles(){
  const box = $('roles'); box.textContent = '';
  players.forEach((p, i) => {
    const s = document.createElement('span'); s.className = 'role' + (i === myIdx ? ' me' : '');
    s.textContent = p.name + ' · ' + roleLabel(p.role);
    box.appendChild(s);
  });
}

// ───────── 결과 / 시상식 ─────────
const AWARDS = [
  ['bump', '벽 박치기 장인', '벽에 {n}번 박음'],
  ['fall', '구멍 다이버', '구멍에 {n}번 빠뜨림'],
  ['trap', '함정 수집가', '함정에 {n}번 밀어 넣음'],
  ['leak', '뚫린 방패', '방어 못 해서 {n}번 맞음'],
  ['miss', '허공 사격수', '총알 {n}발을 벽에 선물'],
  ['empty', '빈총 연타범', '총알 없는데 {n}번 쏨'],
  ['hits', '명사수', '{n}발 명중'],
  ['parry', '패링 장인', '패링 {n}번 성공'],
];
function showResult(v){
  const ov = $('overlay');
  $('ovTitle').textContent = v.win ? '탈출 성공!' : v.why === 'time' ? '시간 초과' : '전멸…';
  const left = Math.max(0, Math.ceil(v.time));
  $('ovSub').textContent = v.win ? `남은 시간 ${Math.floor(left/60)}분 ${left % 60}초, 남은 체력 ${v.pl.hp}` : v.why === 'time' ? '5분 안에 나가지 못했어요.' : `${STAGES[v.stage].name}에서 쓰러졌어요.`;
  const aw = $('awards'); aw.textContent = '';
  const st = v.stats || [];
  for (const [k, title, fmt] of AWARDS) {
    let best = -1, bv = 0;
    st.forEach((s, i) => { const n = num(s && s[k], 0); if (n > bv) { bv = n; best = i; } });
    if (best < 0 || !players[best]) continue;
    if (st.length > 1 && st.every(s => num(s && s[k], 0) === bv)) continue; // 다 같이 똑같으면 상 없음
    const d = document.createElement('div'); d.className = 'aw';
    d.textContent = '🏆 ' + title + ' · ' + players[best].name;
    const sm = document.createElement('small'); sm.textContent = fmt.replace('{n}', bv);
    d.appendChild(sm); aw.appendChild(d);
  }
  if (!aw.children.length) { const d = document.createElement('p'); d.textContent = '특별히 놀릴 거리가 없네요. 아쉽다.'; aw.appendChild(d); }
  const host = mode !== 'client';
  $('againBtn').style.display = host ? '' : 'none';
  $('menuBtn').textContent = host ? (mode === 'host' ? '대기실로' : '메뉴로') : '나가기';
  if (!host) $('ovSub').textContent += ' · 방장이 다시 시작하면 이어져요.';
  ov.style.display = 'flex'; resultShown = true;
}
let resultShown = false;
function hideResult(){ $('overlay').style.display = 'none'; resultShown = false; }

// ───────── 온라인 (PeerJS) ─────────
const ICE = { iceServers:[ { urls:'stun:stun.l.google.com:19302' }, { urls:'stun:stun1.l.google.com:19302' }, { urls:'stun:stun.cloudflare.com:3478' } ] };
const ID_PREFIX = 'hanmom-wonjeongdae-';
let net = null, roomCode = '', lobby = [], clientLobby = null, sendT = 0, lobbyT = 0, lastSent = '';
function nickName(){ const v = $('nick').value.trim().slice(0, 8); return v || '플레이어'; }
function cleanNick(v){ return (typeof v === 'string' ? v : '').replace(/[\u0000-\u001f\u200b-\u200f\u202a-\u202e\u2060-\u206f]/g, '').slice(0, 8) || '친구'; }
function randCode(){ const a = 'abcdefghjkmnpqrstuvwxyz23456789'; let s = ''; for (let i = 0; i < 4; i++) s += a[Math.floor(Math.random()*a.length)]; return s; }
function setOnlineNote(){
  const ok = !!window.Peer;
  $('goHost').disabled = !ok; $('goJoin').disabled = !ok;
  $('onlineNote').textContent = ok ? '방을 만들고 초대 링크를 카톡으로 보내면 친구가 로그인 없이 들어와요.' : '온라인 연결 도구를 불러오지 못했어요. 혼자 테스트는 그대로 할 수 있어요.';
}
$('goHost').disabled = true; $('goJoin').disabled = true;
if (document.readyState === 'complete') setOnlineNote(); else addEventListener('load', setOnlineNote);
(function(){ const m = /^#([a-z0-9]{4})$/i.exec(location.hash || ''); if (m) { $('joinCode').value = m[1].toLowerCase(); setTimeout(() => { $('onlineErr').textContent = '초대 코드가 입력됐어요. 이름을 정하고 참여를 눌러 주세요.'; }, 0); } })();

function sendAll(msg){ if (!net || !net.conns) return; for (const c of net.conns.values()) if (c.open) { try { c.send(msg); } catch (e) {} } }
function lobbyList(){ return [{ peer:'host', name:nickName() }].concat(lobby.slice(0, 3)); }
function emitLobby(){
  if (mode !== 'hostLobby' && mode !== 'host') return;
  const list = mode === 'host' ? players.map(p => ({ peer:p.peer, name:p.name, role:p.role })) : withRoles(lobbyList());
  sendAll({ t:'lobby', d:{ list, ph:mode === 'host' ? 'play' : 'lobby' } });
}
function withRoles(list){ const rs = ROLESETS[Math.min(4, list.length)]; return list.map((p, i) => ({ peer:p.peer, name:p.name, role:rs[i] })); }
function renderLobby(){
  $('lobbyCode').textContent = roomCode.toUpperCase();
  const host = mode === 'hostLobby' || mode === 'host';
  $('inviteBtn').style.display = host ? '' : 'none';
  $('lobbyStart').style.display = host ? '' : 'none';
  const box = $('lobbyList'); box.textContent = '';
  const list = host ? withRoles(lobbyList()) : (clientLobby ? clientLobby.list : []);
  if (!list.length) { const d = document.createElement('p'); d.className = 'note'; d.textContent = '방장과 연결하는 중이에요…'; box.appendChild(d); }
  list.forEach((p, i) => {
    const row = document.createElement('div'); row.className = 'slot';
    const lbl = document.createElement('span'); lbl.className = 'lbl';
    lbl.textContent = (i + 1) + '. ' + cleanNick(p.name) + ((host && i === 0) || (!host && p.peer === myPeerId) ? ' (나)' : '');
    const sm = document.createElement('small'); sm.textContent = roleLabel(String(p.role || ''));
    row.append(lbl, sm); box.appendChild(row);
  });
  if (!host && clientLobby && clientLobby.ph === 'play') { const d = document.createElement('p'); d.className = 'note'; d.textContent = '게임이 이미 진행 중이에요.'; box.appendChild(d); }
  if (host) { $('lobbyErr').textContent = list.length < 2 ? '혼자서도 출발할 수 있어요. 친구가 들어오면 역할이 자동으로 나뉘어요.' : ''; }
}
let myPeerId = null;
function hostRoom(){
  $('onlineErr').textContent = ''; $('goHost').disabled = true;
  let tries = 0;
  const attempt = () => {
    const code = randCode();
    const peer = new Peer(ID_PREFIX + code, { config:ICE, debug:0 });
    let opened = false;
    const conns = new Map();
    peer.on('open', () => {
      opened = true; net = { peer, conns }; roomCode = code; lobby = []; mode = 'hostLobby'; myPeerId = 'host';
      $('goHost').disabled = false; showScreen('scrLobby'); renderLobby();
    });
    peer.on('error', e => {
      if (!opened) { try { peer.destroy(); } catch (x) {} if (e && e.type === 'unavailable-id' && ++tries < 4) attempt(); else { $('goHost').disabled = false; $('onlineErr').textContent = '방을 만들지 못했어요. 인터넷 연결을 확인하고 다시 해 보세요.'; } }
    });
    peer.on('disconnected', () => { if (net && net.peer === peer) { try { peer.reconnect(); } catch (e) {} } });
    peer.on('connection', conn => {
      conn.on('open', () => {
        if (mode !== 'hostLobby' || lobby.length >= 3) { try { conn.send({ t:'full' }); setTimeout(() => conn.close(), 300); } catch (e) {} return; }
        conns.set(conn.peer, conn);
      });
      conn.on('data', d => {
        if (!d || typeof d !== 'object') return;
        if (d.t === 'hello' && conns.get(conn.peer) === conn && !lobby.find(p => p.peer === conn.peer)) {
          lobby.push({ peer:conn.peer, name:cleanNick(d.name) }); renderLobby(); emitLobby();
        } else if (d.t === 'k' && Array.isArray(d.k) && d.k.length === 6) remoteKeys.set(conn.peer, d.k.map(v => num(v, 0)));
        else if (d.t === 'say' && typeof d.id === 'string' && mode === 'host') hostSay(conn.peer, d.id);
      });
      const gone = () => {
        if (conns.get(conn.peer) !== conn) return;
        conns.delete(conn.peer);
        if (mode === 'host' && players.some(p => p.peer === conn.peer)) { blowRoom('누가 나가서 방이 터졌어요.'); return; }
        lobby = lobby.filter(p => p.peer !== conn.peer); renderLobby(); emitLobby();
      };
      conn.on('close', gone); conn.on('error', gone);
    });
  };
  attempt();
}
function blowRoom(msg){
  sendAll({ t:'end', msg });
  const n = net; net = null;
  setTimeout(() => { if (n) try { n.peer.destroy(); } catch (e) {} }, 400);
  G = null; mode = 'menu'; hideResult(); showScreen('scrMenu'); $('onlineErr').textContent = msg;
}
function joinRoom(){
  $('onlineErr').textContent = '';
  const code = $('joinCode').value.trim().toLowerCase();
  if (!/^[a-z0-9]{4}$/.test(code)) { $('onlineErr').textContent = '방 코드 4자리를 입력해 주세요.'; return; }
  $('goJoin').disabled = true; $('onlineErr').textContent = '방에 연결하는 중이에요…';
  const peer = new Peer({ config:ICE, debug:0 });
  let done = false;
  const fail = msg => { if (done) return; done = true; try { peer.destroy(); } catch (e) {} $('goJoin').disabled = false; $('onlineErr').textContent = msg; };
  const timer = setTimeout(() => fail('연결이 너무 오래 걸려요. 둘 다 와이파이에 연결한 뒤 다시 해 보세요.'), 15000);
  peer.on('open', id => {
    myPeerId = id;
    const conn = peer.connect(ID_PREFIX + code, { serialization:'json', reliable:true });
    conn.on('open', () => {
      if (done) return; done = true; clearTimeout(timer);
      net = { peer, conn }; roomCode = code; clientLobby = null; mode = 'clientLobby';
      conn.send({ t:'hello', name:nickName() });
      $('goJoin').disabled = false; $('onlineErr').textContent = '';
      showScreen('scrLobby'); renderLobby();
    });
    conn.on('data', d => {
      if (!d || typeof d !== 'object') return;
      if (d.t === 'full') { clientLeave('방이 꽉 찼거나 이미 게임 중이에요.'); return; }
      if (d.t === 'end') { clientLeave(typeof d.msg === 'string' ? d.msg.slice(0, 40) : '방이 닫혔어요.'); return; }
      if (d.t === 'lobby' && d.d && Array.isArray(d.d.list)) {
        clientLobby = { list:d.d.list.slice(0, 4).map(p => ({ peer:String(p.peer || ''), name:cleanNick(p.name), role:/^[udlrfs]{1,6}$/.test(p.role) ? p.role : '' })), ph:d.d.ph };
        if (mode === 'clientLobby') renderLobby();
        if (d.d.ph === 'play') { players = clientLobby.list.map(p => ({ name:p.name, role:p.role, peer:p.peer })); myIdx = players.findIndex(p => p.peer === myPeerId); }
      }
      if (d.t === 'state' && d.d && typeof d.d === 'object') onState(d.d);
      if (d.t === 'say' && typeof d.id === 'string' && mode === 'client') showSay(cleanNick(d.from), d.id);
    });
    conn.on('close', () => { if (net && net.conn === conn) clientLeave('방장과 연결이 끊겼어요.'); });
  });
  peer.on('error', e => {
    clearTimeout(timer);
    if (!done) fail(e && e.type === 'peer-unavailable' ? '그 코드의 방이 없어요. 코드를 확인해 주세요.' : '방에 들어가지 못했어요. 인터넷 연결을 확인해 주세요.');
  });
}
function clientLeave(msg){
  const n = net; net = null;
  if (n) try { n.peer.destroy(); } catch (e) {}
  VM = null; mode = 'menu'; hideResult(); showScreen('scrMenu'); $('onlineErr').textContent = msg || '';
}
function onState(s){
  const v = viewFromSnap(s);
  if (Array.isArray(s.fx)) for (const f of s.fx.slice(0, 10)) if (Array.isArray(f)) floats.push({ x:num(f[0], 0), y:num(f[1], 0), text:String(f[2] || '').slice(0, 12), color:/^#[0-9a-fA-F]{3,6}$/.test(f[3]) ? f[3] : '#fff', t:0 });
  if (s.sfx && SFX[s.sfx]) SFX[s.sfx]();
  if (mode !== 'client') { if (!players.length) return; startPlay('client'); }
  if (VM && VM.stage !== v.stage) disp.pl = null;
  v.overT = v.over && VM && VM.over ? VM.overT : 0;
  VM = v;
  if (!v.over && resultShown) hideResult();
}
$('inviteBtn').onclick = async () => {
  const url = location.origin + location.pathname + '#' + roomCode;
  const text = '한몸 원정대 같이 하자! 방 코드 ' + roomCode.toUpperCase();
  try { if (navigator.share) { await navigator.share({ title:'한몸 원정대', text, url }); return; } } catch (e) { if (e && e.name === 'AbortError') return; }
  try { await navigator.clipboard.writeText(text + '\n' + url); $('inviteBtn').textContent = '복사했어요!'; setTimeout(() => { $('inviteBtn').textContent = '초대 링크 보내기'; }, 1800); }
  catch (e) { prompt('이 주소를 복사해서 보내 주세요', url); }
};

// ───────── 화면 / 흐름 ─────────
function showScreen(id){ document.querySelectorAll('.screen').forEach(s => s.classList.toggle('on', s.id === id)); }
function myRole(){ return (players[myIdx] && players[myIdx].role) || 'udlrfs'; }
function startPlay(m){
  mode = m; hideResult(); showScreen('none'); toggleCalls(false); $('shout').textContent = ''; $('cdBig').style.display = 'none'; cdTimers.forEach(clearTimeout); feedHint(); held.clear(); floats.length = 0; disp.pl = null; disp.en.clear(); hudKey = '';
  renderRoles(); buildPad(); requestAnimationFrame(resize);
}
function startSolo(){
  players = [{ name:nickName(), role:'udlrfs', local:true }]; myIdx = 0;
  G = newGame(players); startPlay('solo');
}
function startHost(){
  const list = withRoles(lobbyList());
  players = list.map((p, i) => ({ name:p.name, role:p.role, peer:p.peer, local:i === 0 }));
  myIdx = 0; remoteKeys = new Map();
  G = newGame(players);
  startPlay('host'); emitLobby();
}
$('goSolo').onclick = () => { initAudio(); startSolo(); };
$('goHost').onclick = () => { initAudio(); hostRoom(); };
$('goJoin').onclick = () => { initAudio(); joinRoom(); };
$('joinCode').addEventListener('keydown', e => { if (e.key === 'Enter') { initAudio(); joinRoom(); } });
$('lobbyStart').onclick = () => { initAudio(); startHost(); };
$('lobbyBack').onclick = () => {
  if (mode === 'hostLobby') blowRoom('방을 닫았어요.');
  else clientLeave('');
};
$('againBtn').onclick = () => { if (mode === 'solo') startSolo(); else if (mode === 'host') startHost(); };
function quit(){
  if (mode === 'solo') { G = null; mode = 'menu'; hideResult(); showScreen('scrMenu'); return; }
  if (mode === 'host') {
    if (G && G.over) { G = null; mode = 'hostLobby'; hideResult(); showScreen('scrLobby'); renderLobby(); emitLobby(); return; }
    blowRoom('방장이 나가서 방이 터졌어요.'); return;
  }
  if (mode === 'client') { clientLeave(''); return; }
}
$('menuBtn').onclick = quit;
$('quitBtn').onclick = quit;
try { const s = sessionStorage.getItem('hm-nick'); if (s) $('nick').value = s; } catch (e) {}
$('nick').addEventListener('change', () => { try { sessionStorage.setItem('hm-nick', $('nick').value.trim()); } catch (e) {} });

// ───────── 루프 ─────────
let last = performance.now(), acc = 0, sentKeys = '';
const H = 1/60;
function frame(now){
  const dt = Math.min(.05, (now - last) / 1000); last = now;
  let v = null;
  if ((mode === 'solo' || mode === 'host') && G) {
    acc += dt;
    while (acc >= H) {
      step(G, gatherInput(), H);
      if (G.sfx) { SFX[G.sfx] && SFX[G.sfx](); G.sfxSent = G.sfx; }
      for (const f of G.fxNew) floats.push({ x:f[0], y:f[1], text:f[2], color:f[3], t:0 });
      if (mode === 'host') { G.fxQ = (G.fxQ || []).concat(G.fxNew); }
      G.fxNew = [];
      acc -= H;
    }
    v = G;
    if (mode === 'host' && net) {
      sendT -= dt;
      if (sendT <= 0) {
        sendT = .05;
        sendAll({ t:'state', d:snapshot(G, G.fxQ) });
        G.fxQ = []; G.sfxSent = null;
      }
      lobbyT -= dt; if (lobbyT <= 0) { lobbyT = 2; emitLobby(); }
    }
  } else if (mode === 'client' && VM) {
    v = VM;
    const k = localKeys(), ks = k.join(',');
    if (ks !== sentKeys && net && net.conn && net.conn.open) { sentKeys = ks; try { net.conn.send({ t:'k', k }); } catch (e) {} }
    const a = Math.min(1, dt*16);
    if (!disp.pl) disp.pl = { x:v.pl.x, y:v.pl.y };
    disp.pl.x += (v.pl.x - disp.pl.x)*a; disp.pl.y += (v.pl.y - disp.pl.y)*a;
    if (Math.hypot(v.pl.x - disp.pl.x, v.pl.y - disp.pl.y) > 1.5) { disp.pl.x = v.pl.x; disp.pl.y = v.pl.y; }
    const seen = new Set();
    for (const e of v.enemies) {
      seen.add(e.id);
      let d = disp.en.get(e.id); if (!d) { d = { x:e.x, y:e.y }; disp.en.set(e.id, d); }
      d.x += (e.x - d.x)*a; d.y += (e.y - d.y)*a;
    }
    for (const id of disp.en.keys()) if (!seen.has(id)) disp.en.delete(id);
    if (v.over) v.overT = (v.overT || 0) + dt;
  } else if (mode === 'hostLobby' && net) {
    lobbyT -= dt; if (lobbyT <= 0) { lobbyT = 1.5; emitLobby(); }
  }
  if (v) {
    if (dimKey !== VW + 'x' + VH) resize();
    draw(v, now); updateHud(v);
    if (v.over && (v.overT || 0) > .9 && !resultShown) showResult(v);
  }
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
})();
</script>
</body>
</html>
